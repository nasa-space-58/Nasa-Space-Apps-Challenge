# Local development only. Choose your own values before starting Compose.
RABBITMQ_USER=lunar
RABBITMQ_PASSWORD=replace-with-local-password

# Per-process local risk worker: exact dynamics only; terrain is always rechecked.
RISK_PHYSICS_CACHE_ENABLED=1
RISK_PHYSICS_CACHE_BYTES=33554432
RISK_PHYSICS_CACHE_ENTRIES=128

# Optional Q&A assistant (Claude API). Leave disabled unless you have a key.
# Keep the real key outside Git: put it in your own .env or a secret store.
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
